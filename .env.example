# Copy the relevant block to each app's .env.local (never commit .env*.local).

# --- apps/mobile/.env.local (public, bundled into the app) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_POSTHOG_KEY=

# --- apps/web/.env.local (public, exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only / Edge Functions (NEVER in client code or EXPO_PUBLIC_/NEXT_PUBLIC_ vars) ---
SUPABASE_SECRET_KEY=sb_secret_...
GOOGLE_PLACES_API_KEY=
